        <mxCell id="w_pico_trig" edge="1" parent="island1" source="pico" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1FA852;strokeWidth=2;fontColor=#1FA852;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" target="hcsr04" value="GROEN: TRIG (GP2 Pin 4 -&amp;gt; TRIG)">
