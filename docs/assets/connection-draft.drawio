        <mxCell id="pico" parent="island1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#22c55e;fontColor=#ffffff;align=left;spacingLeft=12;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Raspberry Pi Pico WH&lt;/b&gt;&lt;hr&gt;• Pin 40: VBUS (5V)&lt;br&gt;• Pin 38: GND&lt;br&gt;• Pin 4: GP2 (TRIG Output)&lt;br&gt;• Pin 5: GP3 (ECHO Input - 3.3V max!)&lt;hr&gt;&lt;i&gt;Wi-Fi MQTT Publisher -&gt; vault/perimeter/distance&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="460" x="30" y="55" as="geometry" />
