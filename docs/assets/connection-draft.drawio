          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_ch1" edge="1" parent="island2" source="m_analog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A16207;strokeWidth=2;fontColor=#A16207;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" target="m_spi" value="BRUIN: LM35 Vout -&amp;gt; CH1 (Pin 2)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_btn" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#22c55e;fontColor=#ffffff;align=left;spacingLeft=12;fontSize=12;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Module 3: Bevestigingsknop Cijferslot (Active-Low)&lt;/b&gt;&lt;hr&gt;• Drukknop op het breadboard (interne Pull-Up weerstand geactiveerd in Python)." vertex="1">
          <mxGeometry height="100" width="570" x="720" y="535" as="geometry" />
        </mxCell>
        <mxCell id="w_btn_sig" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1FA852;strokeWidth=3;fontColor=#1FA852;exitX=0.994;exitY=0.443;entryX=0;entryY=0.35;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_btn" value="GROEN: GPIO 4 (Pin 7) -&amp;gt; Knop Pootje 1">
