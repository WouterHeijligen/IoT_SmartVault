          <mxGeometry relative="1" x="-0.0184" as="geometry" />
        </mxCell>
        <mxCell id="w_spi_cs" edge="1" parent="island2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A16207;strokeWidth=2;fontColor=#A16207;entryX=0.005;entryY=0.844;entryDx=0;entryDy=0;entryPerimeter=0;" target="m_spi" value="BRUIN: GPIO 8 (CE0) -&amp;gt; Pin 10 (CS)">
          <mxGeometry relative="1" x="-0.0188" as="geometry">
            <mxPoint x="320" y="460" as="sourcePoint" />
            <mxPoint x="602.4799999999996" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m_analog" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#fb923c;fontColor=#ffffff;align=left;spacingLeft=10;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Module 2B: Analoge Sensoren&lt;/b&gt;&lt;hr&gt;&lt;b&gt;10k Potmeter (Cijferslot 0-9):&lt;/b&gt;&lt;br&gt;• Pootje 1: GND | Pootje 3: 3.3V&lt;br&gt;• Loper (midden) -&gt; CH0 (Pin 1)&lt;hr&gt;&lt;b&gt;LM35 Temp Sensor:&lt;/b&gt;&lt;br&gt;• Links: 3.3V | Rechts: GND&lt;br&gt;• Vout (midden) -&gt; CH1 (Pin 2)" vertex="1">
          <mxGeometry height="250" width="210" x="1090" y="250" as="geometry" />
        </mxCell>
