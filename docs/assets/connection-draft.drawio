          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_relay" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#ef4444;fontColor=#ffffff;align=left;spacingLeft=12;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Module 4A: 5V Relais (Motor Safety Interlock)&lt;/b&gt;&lt;hr&gt;• Laagspanning: VCC (5V), GND, IN (GPIO 24 - Active-Low)&lt;br&gt;• Schroefklemmen: &lt;b&gt;COM&lt;/b&gt; (5V In) en &lt;b&gt;NO&lt;/b&gt; (Geschakelde 5V Uit naar Motor)" vertex="1">
          <mxGeometry height="120" width="570" x="720" y="660" as="geometry" />
        </mxCell>
        <mxCell id="w_rel_vcc" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ef4444;strokeWidth=3;fontColor=#EF4444;exitX=1.003;exitY=0.542;entryX=0;entryY=0.22;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_relay" value="ROOD: 5V Rail -&amp;gt; Relais VCC én Relais COM-schroefklem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_rel_gnd" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;exitX=1;exitY=0.576;entryX=0;entryY=0.52;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_relay" value="ZWART: GND Rail -&amp;gt; Relais GND">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_rel_in" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=2;fontColor=#999999;exitX=1.002;exitY=0.607;entryX=0;entryY=0.82;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_relay" value="WIT: GPIO 24 (Pin 18) -&amp;gt; Relais IN (False = Relais AAN)">
          <mxGeometry relative="1" x="-0.0022" as="geometry" />
        </mxCell>
        <mxCell id="m_stepper" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#22c55e;fontColor=#ffffff;align=left;spacingLeft=12;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Module 4B: ULN2003 Driver + 28BYJ-48 Stappenmotor (Met 3D Push-Pin)&lt;/b&gt;&lt;hr&gt;• Voeding + (5V) komt UITSLUITEND vanaf de &lt;b&gt;NO-schroefklem&lt;/b&gt; van het relais!&lt;br&gt;• Voeding - (GND) gaat naar de GND Rail op het breadboard.&lt;br&gt;• 4x Full-Step spoelaansturing: IN1, IN2, IN3, IN4." vertex="1">
          <mxGeometry height="170" width="570" x="720" y="845" as="geometry" />
        </mxCell>
        <mxCell id="w_no_to_motor" edge="1" parent="island2" source="m_relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ef4444;strokeWidth=4;fontColor=#EF4444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m_stepper" value="DIK ROOD: Relais NO-klem -&amp;gt; ULN2003 +5V Voedingspin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_step_in1" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#7dd3fc;exitX=1.006;exitY=0.71;entryX=0;entryY=0.18;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_stepper" value="BLAUW: GPIO 17 (Pin 11) -&gt; ULN2003 IN1">
