        <mxCell id="w_echo_out" edge="1" parent="island1" source="divider" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EAB308;strokeWidth=2;fontColor=#EAB308;exitX=0.5;exitY=0;entryX=0.608;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" target="pico" value="GEEL: ECHO 3.3V (van R1/R2 -&amp;gt; GP3 Pin 5)">
          <mxGeometry relative="1" x="0.0267" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748b;fontColor=#f8fafc;align=left;spacingLeft=14;fontSize=11;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;b style=&quot;font-size: 13px; color: rgb(0, 0, 0); line-height: 150%;&quot;&gt;VASTE KLEURCODES (Consistent per signaaltype):&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;color: rgb(239, 68, 68);&quot;&gt;■ ROOD: Alle 5V Voeding (Relais VCC, COM, NO, HC-SR04 VCC) &amp;amp; Rood RGD LED&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font color=&quot;#f97316&quot;&gt;■ ORANJE: Alle 3.3V Voeding (Sensoren, MCP3008 VDD/VREF)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;■ ZWART: Alle GND / Massa verbindingen&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#38bdf8&quot;&gt;■ BLAUW: I2C SDA &amp;amp; Stappenmotor Spoel 1 (IN1)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#eab308&quot;&gt;■ GEEL: Kloksignalen (I2C SCL, SPI SCLK) &amp;amp; Stappenmotor IN3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(31, 168, 82);&quot;&gt;■ GROEN: Digitale Inputs / Knop / Potmeter CH0 / RGB Groen&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(124, 61, 186);&quot;&gt;■ PAARS: SPI MISO &amp;amp; Stappenmotor IN2 &amp;amp; Echo 5V&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;■ WIT: SPI MOSI (DIN) &amp;amp; Relais Signaal (IN)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#a16207&quot;&gt;■ BRUIN: SPI CS (CE0) &amp;amp; LM35 Temperatuur (CH1)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="520" x="22" y="990" as="geometry" />
        </mxCell>
        <mxCell id="island2" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#a855f7;fontColor=#e9d5ff;fontSize=14;fontStyle=1;startSize=35;rounded=1;" value=" " vertex="1">
          <mxGeometry height="1240" width="1320" x="572" y="80" as="geometry" />
        </mxCell>
        <mxCell id="rpi5" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f8fafc;fontColor=#ffffff;align=left;spacingLeft=14;fontSize=12;verticalAlign=top;spacingTop=15;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Raspberry Pi 5&lt;br&gt;(T-Cobbler op Breadboard B)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;VOEDING RAILS:&lt;/b&gt;&lt;br&gt;• 3V3 (Pin 1/17) -&gt; 3.3V Rail&lt;br&gt;• 5V (Pin 2/4) -&gt; 5V Rail&lt;br&gt;• GND (Pin 6/9/14/20) -&gt; GND Rail&lt;hr&gt;&lt;b&gt;I2C BUS:&lt;/b&gt;&lt;br&gt;• GPIO 2 (SDA1 - Pin 3)&lt;br&gt;• GPIO 3 (SCL1 - Pin 5)&lt;hr&gt;&lt;b&gt;SPI0 BUS:&lt;/b&gt;&lt;br&gt;• GPIO 11 (SCLK - Pin 23)&lt;br&gt;• GPIO 9 (MISO - Pin 21)&lt;br&gt;• GPIO 10 (MOSI - Pin 19)&lt;br&gt;• GPIO 8 (CE0 - Pin 24)&lt;hr&gt;&lt;b&gt;CIJFERSLOT KNOP:&lt;/b&gt;&lt;br&gt;• GPIO 4 (Pin 7)&lt;hr&gt;&lt;b&gt;MOTOR INTERLOCK &amp; STEPPER:&lt;/b&gt;&lt;br&gt;• GPIO 24 (Pin 18) -&gt; Relais IN&lt;br&gt;• GPIO 17 (Pin 11) -&gt; IN1&lt;br&gt;• GPIO 27 (Pin 13) -&gt; IN2&lt;br&gt;• GPIO 22 (Pin 15) -&gt; IN3&lt;br&gt;• GPIO 23 (Pin 16) -&gt; IN4&lt;hr&gt;&lt;b&gt;RGB LED (PWM):&lt;/b&gt;&lt;br&gt;• GPIO 12 (Pin 32) -&gt; Rood&lt;br&gt;• GPIO 13 (Pin 33) -&gt; Groen&lt;br&gt;• GPIO 19 (Pin 35) -&gt; Blauw" vertex="1">
          <mxGeometry height="1150" width="290" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="m_i2c" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;fontColor=#ffffff;align=left;spacingLeft=12;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Module 1: I2C Bus — BH1750 Lichtsensor (0x23) &amp; SSD1306 OLED (0x3C)&lt;/b&gt;&lt;hr&gt;• Beide modules delen op het breadboard exact hetzelfde rijtje voor SDA en SCL.&lt;br&gt;• BH1750 ADDR-pin los laten of met GND verbinden." vertex="1">
          <mxGeometry height="170" width="570" x="720" y="60" as="geometry" />
        </mxCell>
        <mxCell id="w_i2c_vcc" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F97316;strokeWidth=2;fontColor=#F97316;exitX=1.002;exitY=0.029;entryX=0;entryY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_i2c" value="ORANJE: 3.3V Rail -&amp;gt; BH1750 VCC &amp;amp; OLED VCC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_i2c_gnd" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;exitX=1.001;exitY=0.055;entryX=0;entryY=0.4;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_i2c" value="ZWART: GND Rail -&amp;gt; BH1750 GND &amp;amp; OLED GND">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_i2c_sda" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#38bdf8;strokeWidth=3;fontColor=#7dd3fc;exitX=1.001;exitY=0.089;entryX=0;entryY=0.65;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_i2c" value="BLAUW: GPIO 2 (Pin 3) -&gt; SDA (BH1750 + OLED)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_i2c_scl" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EAB308;strokeWidth=3;fontColor=#EAB308;exitX=1.004;exitY=0.128;entryX=0;entryY=0.88;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_i2c" value="GEEL: GPIO 3 (Pin 5) -&amp;gt; SCL (BH1750 + OLED)">
          <mxGeometry relative="1" x="-0.0069" as="geometry" />
        </mxCell>
        <mxCell id="m_spi" parent="island2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#a855f7;fontColor=#ffffff;align=left;spacingLeft=12;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Module 2A: MCP3008 ADC Chip (SPI0 Bus)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Rechterzijde (Pin 16..9):&lt;/b&gt;&lt;br&gt;• Pin 16 (VDD) &amp; Pin 15 (VREF) -&gt; 3.3V&lt;br&gt;• Pin 14 (AGND) &amp; Pin 9 (DGND) -&gt; GND&lt;br&gt;• Pin 13 (CLK) | Pin 12 (DOUT)&lt;br&gt;• Pin 11 (DIN) | Pin 10 (CS/SHDN)" vertex="1">
          <mxGeometry height="250" width="280" x="605" y="250" as="geometry" />
        </mxCell>
        <mxCell id="w_spi_vcc" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f97316;strokeWidth=2;fontColor=#F97316;exitX=0.997;exitY=0.188;entryX=0;entryY=0.12;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_spi" value="ORANJE: 3.3V Rail -&amp;gt; Pin 16 (VDD) &amp;amp; 15 (VREF)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_spi_gnd" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;exitX=0.991;exitY=0.222;entryX=0;entryY=0.26;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_spi" value="ZWART: GND Rail -&amp;gt; Pin 14 (AGND) &amp;amp; 9 (DGND)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_spi_clk" edge="1" parent="island2" source="rpi5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EAB308;strokeWidth=2;fontColor=#EAB308;entryX=0;entryY=0.44;exitX=1;exitY=0.259;exitDx=0;exitDy=0;exitPerimeter=0;" target="m_spi" value="GEEL: GPIO 11 (SCLK) -&amp;gt; Pin 13 (CLK)">
